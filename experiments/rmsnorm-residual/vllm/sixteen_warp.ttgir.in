// One token row per CUDA block, one contiguous BF16 vector per physical lane.
#tile = #ttg.blocked<{sizePerThread = [1, 8], threadsPerWarp = [32, 1], warpsPerCTA = [16, 1], order = [1, 0]}>
#lanes = #ttg.slice<{dim = 1, parent = #tile}>
#columns = #ttg.slice<{dim = 0, parent = #tile}>
#paired = #ttg.blocked<{sizePerThread = [1, 4, 2], threadsPerWarp = [32, 1, 1], warpsPerCTA = [16, 1, 1], order = [2, 1, 0]}>
#four = #ttg.blocked<{sizePerThread = [1, 4], threadsPerWarp = [32, 1], warpsPerCTA = [16, 1], order = [1, 0]}>
#quartered = #ttg.blocked<{sizePerThread = [1, 2, 2], threadsPerWarp = [32, 1, 1], warpsPerCTA = [16, 1, 1], order = [2, 1, 0]}>
#two = #ttg.blocked<{sizePerThread = [1, 2], threadsPerWarp = [32, 1], warpsPerCTA = [16, 1], order = [1, 0]}>
#one = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [16], order = [0]}>

module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 16 : i32, ttg.target = "cuda:90", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @sixteen_warp_rmsnorm(
      %x: !tt.ptr<bf16> {tt.divisibility = 16 : i32},
      %residual: !tt.ptr<bf16> {tt.divisibility = 16 : i32},
      %weight: !tt.ptr<bf16> {tt.divisibility = 16 : i32}) {
    %width = arith.constant 4096 : i32
    %vector_width = arith.constant dense<8> : tensor<512x1xi32, #tile>
    %denominator = arith.constant dense<4.096000e+03> : tensor<512xf32, #lanes>
    %epsilon = arith.constant dense<9.99999997E-7> : tensor<512xf32, #lanes>
    %row = tt.get_program_id x : i32
    %row_start = arith.muli %row, %width : i32
    %lanes_vec = tt.make_range {start = 0 : i32, end = 512 : i32} : tensor<512xi32, #lanes>
    %lanes_tile = tt.expand_dims %lanes_vec {axis = 1 : i32} : tensor<512xi32, #lanes> -> tensor<512x1xi32, #tile>
    %vector_starts = arith.muli %lanes_tile, %vector_width : tensor<512x1xi32, #tile>
    %vector_columns = tt.make_range {start = 0 : i32, end = 8 : i32} : tensor<8xi32, #columns>
    %columns_tile = tt.expand_dims %vector_columns {axis = 0 : i32} : tensor<8xi32, #columns> -> tensor<1x8xi32, #tile>
    %starts = tt.broadcast %vector_starts : tensor<512x1xi32, #tile> -> tensor<512x8xi32, #tile>
    %offsets = tt.broadcast %columns_tile : tensor<1x8xi32, #tile> -> tensor<512x8xi32, #tile>
    %cols = arith.addi %starts, %offsets : tensor<512x8xi32, #tile>
    %bases = tt.splat %row_start : i32 -> tensor<512x8xi32, #tile>
    %positions = arith.addi %bases, %cols : tensor<512x8xi32, #tile>
    %x_base = tt.splat %x : !tt.ptr<bf16> -> tensor<512x8x!tt.ptr<bf16>, #tile>
    %r_base = tt.splat %residual : !tt.ptr<bf16> -> tensor<512x8x!tt.ptr<bf16>, #tile>
    %x_addr = tt.addptr %x_base, %positions : tensor<512x8x!tt.ptr<bf16>, #tile>, tensor<512x8xi32, #tile>
    %r_addr = tt.addptr %r_base, %positions : tensor<512x8x!tt.ptr<bf16>, #tile>, tensor<512x8xi32, #tile>
    %xb = tt.load %x_addr : tensor<512x8x!tt.ptr<bf16>, #tile>
    %rb = tt.load %r_addr : tensor<512x8x!tt.ptr<bf16>, #tile>
    %xf = arith.extf %xb : tensor<512x8xbf16, #tile> to tensor<512x8xf32, #tile>
    %rf = arith.extf %rb : tensor<512x8xbf16, #tile> to tensor<512x8xf32, #tile>
    %sum = arith.addf %xf, %rf : tensor<512x8xf32, #tile>
    %rounded = arith.truncf %sum : tensor<512x8xf32, #tile> to tensor<512x8xbf16, #tile>
    tt.store %r_addr, %rounded : tensor<512x8x!tt.ptr<bf16>, #tile>

    // Sum adjacent squared pairs, then add the four pairs in vLLM order.
    %z = arith.extf %rounded : tensor<512x8xbf16, #tile> to tensor<512x8xf32, #tile>
    %pair_view = tt.reshape %z : tensor<512x8xf32, #tile> -> tensor<512x4x2xf32, #paired>
    %pair_left, %pair_right = tt.split %pair_view : tensor<512x4x2xf32, #paired> -> tensor<512x4xf32, #four>
    %sq_left = arith.mulf %pair_left, %pair_left : tensor<512x4xf32, #four>
    %sq_right = arith.mulf %pair_right, %pair_right : tensor<512x4xf32, #four>
    %pairs = arith.addf %sq_left, %sq_right : tensor<512x4xf32, #four>
    %pair_groups = tt.reshape %pairs : tensor<512x4xf32, #four> -> tensor<512x2x2xf32, #quartered>
    %even, %odd = tt.split %pair_groups : tensor<512x2x2xf32, #quartered> -> tensor<512x2xf32, #two>
    %p0, %p2 = tt.split %even : tensor<512x2xf32, #two> -> tensor<512xf32, #one>
    %p1, %p3 = tt.split %odd : tensor<512x2xf32, #two> -> tensor<512xf32, #one>
    %sum01 = arith.addf %p0, %p1 : tensor<512xf32, #one>
    %sum012 = arith.addf %sum01, %p2 : tensor<512xf32, #one>
    %sum0123 = arith.addf %sum012, %p3 : tensor<512xf32, #one>
    %partial = ttg.convert_layout %sum0123 : tensor<512xf32, #one> -> tensor<512xf32, #lanes>
    %total = tt.elementwise_inline_asm "@ORDERED_SUM@" {constraints = "=f,f,r", packed_element = 1 : i32, pure = false} %partial, %lanes_vec : tensor<512xf32, #lanes>, tensor<512xi32, #lanes> -> tensor<512xf32, #lanes>

    %mean = arith.divf %total, %denominator : tensor<512xf32, #lanes>
    %mean_eps = arith.addf %mean, %epsilon : tensor<512xf32, #lanes>
    %inverse = math.rsqrt %mean_eps : tensor<512xf32, #lanes>
    %expanded = tt.expand_dims %inverse {axis = 1 : i32} : tensor<512xf32, #lanes> -> tensor<512x1xf32, #tile>
    %scales = tt.broadcast %expanded : tensor<512x1xf32, #tile> -> tensor<512x8xf32, #tile>
    %scaled = arith.mulf %z, %scales : tensor<512x8xf32, #tile>
    %scaled_bf16 = arith.truncf %scaled : tensor<512x8xf32, #tile> to tensor<512x8xbf16, #tile>
    %scaled_f32 = arith.extf %scaled_bf16 : tensor<512x8xbf16, #tile> to tensor<512x8xf32, #tile>
    %w_base = tt.splat %weight : !tt.ptr<bf16> -> tensor<512x8x!tt.ptr<bf16>, #tile>
    %w_addr = tt.addptr %w_base, %cols : tensor<512x8x!tt.ptr<bf16>, #tile>, tensor<512x8xi32, #tile>
    %wb = tt.load %w_addr : tensor<512x8x!tt.ptr<bf16>, #tile>
    %wf = arith.extf %wb : tensor<512x8xbf16, #tile> to tensor<512x8xf32, #tile>
    %weighted = arith.mulf %scaled_f32, %wf : tensor<512x8xf32, #tile>
    %output = arith.truncf %weighted : tensor<512x8xf32, #tile> to tensor<512x8xbf16, #tile>
    tt.store %x_addr, %output : tensor<512x8x!tt.ptr<bf16>, #tile>
    tt.return
  }
}
